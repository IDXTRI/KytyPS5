#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// DRAW_INDIRECT / DRAW_INDEX_INDIRECT of a mesh-shader (NGG) pipeline: the host expands the
// guest's vertex or index count into mesh workgroups and passes the draw parameters to the mesh
// shader. Reading the GPU-written arguments on the CPU drained the GPU once per draw, so this
// pass turns them into a VkDrawMeshTasksIndirectCommandEXT and the mesh shader's draw
// parameters on the GPU (MeshIndirectArgs, renderDraw.cpp).

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer GuestArgs {
    uint args[5];
};

layout(std430, binding = 0) writeonly buffer Entries {
    uint entries[];
};

layout(push_constant) uniform Push {
    uvec2 args_address;
    uint  indexed;        // DrawIndexedIndirectCommand (5 dwords) or DrawIndirectCommand (4)
    uint  max_count;      // indexed: the bound index buffer's element count
    uint  primitive_size; // input primitive: vertices of the first primitive
    uint  primitive_step; // vertices each further primitive adds
    uint  primitives_per_group;
    uint  max_groups_x;
    uint  max_groups_y;
    uint  max_groups_total;
    uint  element_size;
    uint  index_low;
    uint  index_high;
    uint  output_dword;
} pc;

void main() {
    GuestArgs guest = GuestArgs(pc.args_address);
    uint count;
    uint instances;
    uint first_instance;
    uint offset;
    uvec2 index_address = uvec2(pc.index_low, pc.index_high);
    if (pc.indexed != 0u) {
        // indexCount, instanceCount, firstIndex, vertexOffset, firstInstance
        count          = min(guest.args[0], pc.max_count);
        instances      = guest.args[1];
        offset         = guest.args[3];
        first_instance = guest.args[4];
        const uint byte_offset = guest.args[2] * pc.element_size;
        const uint low         = index_address.x + byte_offset;
        index_address.y += low < index_address.x ? 1u : 0u;
        index_address.x  = low;
    } else {
        // vertexCount, instanceCount, firstVertex, firstInstance
        count          = guest.args[0];
        instances      = guest.args[1];
        offset         = guest.args[2];
        first_instance = guest.args[3];
    }
    const uint primitives =
        count < pc.primitive_size ? 0u : (count - pc.primitive_size) / max(pc.primitive_step, 1u) + 1u;
    uint groups = primitives == 0u ? 0u : (primitives - 1u) / max(pc.primitives_per_group, 1u) + 1u;
    // The host's mesh workgroup limits; the CPU path stopped the emulator past them.
    groups    = min(groups, pc.max_groups_x);
    instances = min(instances, pc.max_groups_y);
    if (groups != 0u && instances > pc.max_groups_total / groups) {
        instances = pc.max_groups_total / groups;
    }
    if (instances == 0u) {
        groups = 0u;
    }
    const uint base = pc.output_dword;
    entries[base + 0u] = groups;
    entries[base + 1u] = instances;
    entries[base + 2u] = 1u;
    entries[base + 3u] = 0u;
    // The mesh shader's draw parameters (renderDraw.cpp, PushData::MeshDrawDwordCount).
    entries[base + 4u] = count;
    entries[base + 5u] = offset;
    entries[base + 6u] = first_instance;
    entries[base + 7u] = pc.element_size;
    entries[base + 8u] = index_address.x;
    entries[base + 9u] = index_address.y;
}
